<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_lower_body_policy</name>
  <version>0.1.0</version>
  <description>
    ONNX 下肢平衡/行走策略层。位于 forward_position_controller 之上：输入
    vx/vy/w/h 四个高层指令，输出 31 轴位置目标（下肢 15 轴由策略给出，上肢与夹爪
    保持固定目标），由 forward_position_controller 带重力补偿写到硬件。
  </description>
  <maintainer email="ruigangli@microsoft.com">ruigangli</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- onnxruntime 没有 rosdep key，由 .devcontainer/Dockerfile 的 pip3 install 提供。 -->

  <exec_depend>unitree_g1_ros2_control</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
