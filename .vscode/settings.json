{
    // 本工作区只在 .devcontainer 里开发，所有路径按容器内的布局写。
    "ROS2.distro": "humble",
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "python.analysis.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",

        "${workspaceFolder}/src/can_bridge_ros",
        "${workspaceFolder}/src/gloria_ros",
        "${workspaceFolder}/src/kwr57_ros",
        "${workspaceFolder}/src/robot_bringup",
        "${workspaceFolder}/src/inverse_kinematics_toolkit/ikt_pose_commander",

        "${workspaceFolder}/sdk/CAN-SDK",
        "${workspaceFolder}/sdk/KWR57-SDK",
        "${workspaceFolder}/sdk/Gloria-M-SDK/src",

        "${workspaceFolder}/install/can_bridge_ros/lib/python3.10/site-packages",
        "${workspaceFolder}/install/gloria_ros/lib/python3.10/site-packages",
        "${workspaceFolder}/install/kwr57_ros/lib/python3.10/site-packages",
        "${workspaceFolder}/install/robot_bringup/lib/python3.10/site-packages",
        "${workspaceFolder}/install/unitree_api/lib/python3.10/site-packages",
        "${workspaceFolder}/install/unitree_hg/lib/python3.10/site-packages"
    ],
    "python.autoComplete.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",
        "${workspaceFolder}/build/robot_bringup",
        "${workspaceFolder}/build/robot_test_dashboard",
        "${workspaceFolder}/build/kwr57_ros",
        "${workspaceFolder}/build/can_bridge_ros",
        "${workspaceFolder}/build/camera_node",
        "${workspaceFolder}/install/robot_bringup/lib/python3.10/site-packages",
        "${workspaceFolder}/install/robot_test_dashboard/lib/python3.10/site-packages",
        "${workspaceFolder}/install/unitree_g1_description/lib/python3.10/site-packages",
        "${workspaceFolder}/install/unitree_hg/lib/python3.10/site-packages",
        "${workspaceFolder}/install/unitree_api/lib/python3.10/site-packages",
        "${workspaceFolder}/install/kwr57_ros/lib/python3.10/site-packages",
        "${workspaceFolder}/install/gloria_ros/lib/python3.10/site-packages",
        "${workspaceFolder}/install/can_bridge_ros/lib/python3.10/site-packages",
        "${workspaceFolder}/install/camera_node/lib/python3.10/site-packages"
    ],
    "python-envs.defaultEnvManager": "ms-python.python:system"
}
