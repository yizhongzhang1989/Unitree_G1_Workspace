[submodule "sdk/Gloria-M-SDK"]
	path = sdk/Gloria-M-SDK
	url = https://github.com/Synria-Robotics/Gloria-M-SDK.git
[submodule "src/unitree_ros2"]
	path = src/unitree_ros2
	url = https://github.com/unitreerobotics/unitree_ros2.git
[submodule "src/robot_test_dashboard"]
	path = src/robot_test_dashboard
	url = https://github.com/yizhongzhang1989/robot_test_dashboard.git
[submodule "src/unitree_g1_description/model"]
	path = src/unitree_g1_description/model
	url = https://github.com/madderscientist/my-UnitreeG1-urdf.git
[submodule "src/inverse_kinematics_toolkit"]
	path = src/inverse_kinematics_toolkit
	url = https://github.com/yizhongzhang1989/inverse_kinematics_toolkit.git
[submodule "src/point_lio_ros2"]
	path = src/point_lio_ros2
	url = https://github.com/dfloreaa/point_lio_ros2.git
	# 本仓库不 fork 它，改动走 patches/point_lio_ros2/*.patch，由
	# scripts/apply_patches.sh 打在工作树上。补丁打上后工作树必然是脏的，
	# 这是设计如此 —— ignore=dirty 让 git status 不再为此刷噪声，但 commit
	# 指针变了照样会报，不影响真正的 submodule 升级。
	ignore = dirty
